# ==========================================
# Local MinIO Configuration
# ==========================================

# Host used when connecting to MinIO from the local machine
MINIO_HOST=localhost

# MinIO API port exposed to the local machine
MINIO_PORT=9000


# ==========================================
# MinIO Credentials
# ==========================================

# Replace these placeholder values in your local .env file
MINIO_USERNAME=your_local_minio_username
MINIO_PASSWORD=your_local_minio_password